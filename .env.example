# Cloud Sync Environment Variables
# Source: Cloud-Sync-MVP.md §4

# ----------------------------------------
# Client-safe variables (Vite build / frontend)
# ----------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ----------------------------------------
# API-only variables (Vercel Serverless Functions)
# ----------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_EMAILS=admin@example.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
TURNSTILE_SECRET=your-turnstile-secret
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=owner@example.com

# Payment destination numbers (public: shown in the UI and returned by /api/plans)
PAYMENT_BKASH_NUMBER=01725111804
PAYMENT_NAGAD_NUMBER=01979996659

# PLANS_JSON - Exact pricing & limits configuration (from Cloud-Sync-MVP.md §4)
PLANS_JSON=[{"id":"sync_monthly","label":"Monthly","priceBdt":49,"days":30,"maxDevices":3,"maxPrompts":500,"blobCap":2097152},{"id":"sync_annual","label":"Annual","priceBdt":390,"days":365,"maxDevices":null,"maxPrompts":null,"blobCap":8388608},{"id":"lifetime","label":"Lifetime","priceBdt":1490,"days":null,"maxDevices":null,"maxPrompts":null,"blobCap":8388608}]

